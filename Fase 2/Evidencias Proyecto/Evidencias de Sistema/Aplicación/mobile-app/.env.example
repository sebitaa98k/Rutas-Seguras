# Configuración del APK. Se lee al ejecutar `npm run build`. Este archivo no se sube a git.
# Dirección del PC donde corren Django (puerto 8000) y el servicio de mapas (puerto 3000).
API_URL=http://192.168.1.100:8000/api
GEO_API_URL=http://192.168.1.100:3000/api/geo
# true: muestra el botón "Servidor" en el login para cambiar la IP desde el teléfono (demostraciones).
MOSTRAR_CAMPO_SERVIDOR=false
